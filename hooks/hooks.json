{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/rose hook user-prompt-submit",
            "timeout": 30,
            "_rose": true,
            "statusMessage": "Recalling lessons\u2026"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/rose hook session-end",
            "timeout": 30,
            "_rose": true,
            "statusMessage": "Learning from this session\u2026"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/rose hook stop",
            "timeout": 15,
            "statusMessage": "Learning check\u2026",
            "_rose": true
          }
        ]
      }
    ]
  }
}
